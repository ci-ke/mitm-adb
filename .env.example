# 复制成 .env 后再填真值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交；本文件（.env.example）不带任何真实密钥。

# ---- 响应体解密（AES-128-CBC）----
# KEY 与 IV 都必须正好 16 字节（都是 ASCII 时 = 16 个字符），否则自动关闭解密
DECRYPT_KEY=0123456789abcdef
DECRYPT_IV=fedcba9876543210

# ---- 三层名单：从上到下逐层收窄，decrypt ⊆ probe ⊆ capture ----
# 域名全部写在这里，脚本里没有内置默认值。
# 六份名单写法一致：
#   *               全部
#   .example.com    这个域连同所有子域
#   api.example.com 只匹配这一条主机名
#
# 每层的 xxx_IGNORE 只剔自己这一层的命中：capture 剔掉的 probe 也不会碰，
# probe 剔掉的仍然留一条 TCP 记录，decrypt 剔掉的仍然能看到明文。
#
# 1) capture = 记录谁。命中的连接都会出现在 mitmweb 列表里：
#    被 probe 命中的是完整请求/响应，其余的只有一条 TCP 记录（只有 host:port）。
#    留空 = 什么都不记录（probe 也会失效，因为 probe 只从 capture 里挑），* = 全记
CAPTURE_HOSTS=*
# 连记录都不要（可选，例：不影响判断的系统域名，逗号分隔）
CAPTURE_IGNORE=

# 2) probe = 换证书谁。只能从 capture 命中的里面挑，越界的会被丢掉。
#    只有这些看得到明文，才有机会解密。留空 = 纯侦察：全部记录但什么都不换证书，
#    设备完全不受打扰，列表里照样能看到这台设备都连了哪些域名。
#    先跑一轮看清单，再挑目标填进来。
PROBE_HOSTS=api.example.com
# 不换证书，但仍然留一条记录（可选，例：sdk.example.com,log.example.com）
PROBE_IGNORE=

# 3) decrypt = 解密谁。只能从 probe 命中的里面挑。
#    留空 = 不启用解密；* = 所有 probe 命中的都解。
DECRYPT_HOSTS=*
# 看得到明文但不去解包的（可选，例：响应特别大的域名）
DECRYPT_IGNORE=
